# ---------------------------------------------------------------------------
# .gitignore — dummy-portfolio (static HTML / SCSS site)
# Only local noise and secrets are ignored. The site itself IS tracked:
# index.html, style.scss, style.css, style.css.map and all .webp assets.
# ---------------------------------------------------------------------------

# macOS / Windows OS metadata
.DS_Store
._*
Thumbs.db
Desktop.ini

# Environment / secrets
.env
.env.*
*.pem
*.key

# Dependencies (this project has none, ignored defensively)
node_modules/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editor / IDE metadata
.vscode/
.idea/
.fleet/
.history/
*.swp
*.swo

# Sass/compiler caches (the compiled style.css IS committed, only caches ignored)
.sass-cache/
